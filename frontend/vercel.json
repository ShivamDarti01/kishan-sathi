{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://kishan-sathi-api.onrender.com/api/:path*"
    },
    {
      "source": "/docs",
      "destination": "https://kishan-sathi-api.onrender.com/docs"
    },
    {
      "source": "/docs/:path*",
      "destination": "https://kishan-sathi-api.onrender.com/docs/:path*"
    },
    {
      "source": "/openapi.json",
      "destination": "https://kishan-sathi-api.onrender.com/openapi.json"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
